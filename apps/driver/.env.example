# URL da API. localhost funciona direto no simulador iOS e no target web.
# Emulador Android: use http://10.0.2.2:3333/api. Dispositivo físico: use o IP
# da máquina na rede local, ex. http://192.168.0.10:3333/api.
EXPO_PUBLIC_API_URL="http://localhost:3333/api"

# Só necessária no Android — o mapa da tela inicial usa Apple Maps no iOS
# (sem chave) e não existe no target web. Sem essa chave no Android, a tela
# mostra um aviso em vez do mapa (ver src/MapSection.native.tsx).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""
