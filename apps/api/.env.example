# Banco de dados
DATABASE_URL="postgresql://central:central@localhost:5432/central?schema=public"

# JWT
JWT_ACCESS_SECRET="troque-este-segredo-em-producao"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-outro-segredo-em-producao"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3333
CORS_ORIGIN="http://localhost:5173,http://localhost:8081,http://localhost:8082"

# Seed inicial (apenas usado por prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@central.local"
SEED_ADMIN_PASSWORD="TrocarAgora!25"

# Integrações futuras (fase 3+) — deixar em branco até serem fornecidas pelo cliente
GOOGLE_MAPS_API_KEY=""
REDIS_URL="redis://localhost:6379"

# Identidade da marca (nome, cor, logo) — definida pela equipe de desenvolvimento
# ANTES do lançamento e mostrada só nos apps (a Central tem identidade própria).
# Estes são os valores PADRÃO: o que a aba "Marca dos apps" (só do usuário
# desenvolvedor) salvar vale mais. Depois de mudar aqui, reinicie a API.
BRAND_NAME="Central de Controle"
BRAND_PRIMARY_COLOR="#0D857A"
BRAND_LOGO_URL=""

# Conta da equipe de desenvolvimento (única com acesso à aba "Marca dos apps"):
SEED_DEV_EMAIL="dev@central.local"
SEED_DEV_PASSWORD="troque-esta-senha"

# Fuso usado em tarifas por horário e no faturamento por dia (Brasília = -03:00)
APP_TZ_OFFSET="-03:00"
